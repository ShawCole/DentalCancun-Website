// Reglas para el administrador del sitio (CMS).
// Agrégalas DENTRO del bloque `match /databases/{database}/documents { ... }`
// de las reglas actuales del proyecto de Firebase. No borres las reglas existentes.

function cmsIsAdmin() {
  return request.auth != null &&
    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
}

// Textos de las páginas: lectura pública (el sitio los muestra), escritura solo administradores.
match /cms_pages/{pageId} {
  allow read: if true;
  allow write: if cmsIsAdmin();
}

// Biblioteca de imágenes: lectura pública, escritura solo administradores.
match /cms_media/{mediaId} {
  allow read: if true;
  allow write: if cmsIsAdmin();
}

// Diagnósticos del quiz: cualquiera puede crear uno (sin leer nada); solo admin y recepción los ven.
match /leads/{leadId} {
  allow create: if request.resource.data.keys().hasOnly([
      'nombre','whatsapp','correo','pais','idioma','necesidad','tratamiento','alternativa','tipo',
      'viaje','agenda','prioridad','regla','notas','ruta','pagina','estado','privacidad','createdAt'])
    && request.resource.data.privacidad == true
    && request.resource.data.estado == 'nuevo'
    && request.resource.data.nombre is string && request.resource.data.nombre.size() < 120
    && request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() < 40
    && request.resource.data.ruta is string && request.resource.data.ruta.size() < 5000;
  allow read, update: if request.auth != null
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'staff'];
  allow delete: if cmsIsAdmin();
}
